// ============================================================
// REGRAS DO FIREBASE STORAGE — AssistHub Multi-tenant
// v3: custom claim para superadmin, 2MB (compressão client-side), tipos restritos
// ============================================================

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Fotos das OS por empresa ───────────────────────────
    // Leitura pública: necessário para exibição no admin e PDF
    // Upload sem auth: técnico sem login envia fotos no campo
    // Restrições: somente jpeg/png/webp, máx 2 MB (compressão client-side garante ≤1 MB)
    // Delete: apenas dono da empresa ou superadmin (custom claim)
    match /empresas/{empresaId}/fotos/{allPaths=**} {
      allow read: if true;

      allow create: if
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if
        request.auth != null && (
          request.auth.uid == empresaId ||
          (request.auth.token.role == 'superadmin' &&
           request.auth.token.superadmin_until > request.time.toMillis() / 1000)
        );
    }

    // ── Logo da empresa ────────────────────────────────────
    // Leitura pública: exibida na sidebar e no formulário público
    // Upload/update: apenas o dono autenticado (uid == empresaId)
    // Delete: dono ou superadmin (custom claim)
    match /empresas/{empresaId}/{fileName} {
      allow read: if true;

      allow create: if
        request.auth != null &&
        request.auth.uid == empresaId &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow update: if
        request.auth != null &&
        request.auth.uid == empresaId &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if
        request.auth != null && (
          request.auth.uid == empresaId ||
          (request.auth.token.role == 'superadmin' &&
           request.auth.token.superadmin_until > request.time.toMillis() / 1000)
        );
    }
  }
}
