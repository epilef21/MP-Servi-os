// ============================================================
// REGRAS DE SEGURANÇA DO FIRESTORE — Multi-tenant
// Versão: v3 (Firebase Auth + isolamento por empresa)
//
// Estrutura de coleções:
//   empresas/{empresaId}/                → dados da empresa
//   empresas/{empresaId}/checklist/{id}  → OS da empresa
//   empresas/{empresaId}/config/geral    → config/personalização
//   usuarios/{uid}                       → vínculo uid → empresaId
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções auxiliares ─────────────────────────────────

    // Verifica se o usuário está autenticado
    function estaAutenticado() {
      return request.auth != null;
    }

    // Verifica se o usuário autenticado é o superadmin
    // O e-mail do superadmin é comparado com o valor gravado
    // no documento /config/superadmin para evitar hardcode nas regras
    function eSuperAdmin() {
      return estaAutenticado() &&
        request.auth.token.email == get(/databases/$(database)/documents/config/superadmin).data.email;
    }

    // Verifica se o uid autenticado é o dono da empresa.
    // Tenta duas formas:
    // 1. uid == empresaId (caminho direto — quando cadastrado pelo CadastroPage)
    // 2. usuarios/{uid}.empresaId == empresaId (caminho via vínculo — fallback)
    function eDonoEmpresa(empresaId) {
      return estaAutenticado() && (
        request.auth.uid == empresaId ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.empresaId == empresaId
      );
    }

    // ── /config — documento de configuração do superadmin ──
    // Apenas o superadmin lê/escreve.
    // Esse documento deve ser criado manualmente no console Firebase:
    //   /config/superadmin → { email: "tvf23407@gmail.com" }
    match /config/{docId} {
      allow read:  if eSuperAdmin();
      allow write: if eSuperAdmin();
    }

    // ── /usuarios/{uid} ────────────────────────────────────
    // Criado no cadastro para vincular uid → empresaId.
    // O próprio usuário pode criar e ler o seu documento.
    // SuperAdmin pode ler todos.
    match /usuarios/{uid} {
      allow read:   if estaAutenticado() && (request.auth.uid == uid || eSuperAdmin());
      allow create: if estaAutenticado() && request.auth.uid == uid;
      allow update: if eSuperAdmin();
      allow delete: if eSuperAdmin();
    }

    // ── /empresas/{empresaId} ──────────────────────────────
    match /empresas/{empresaId} {

      // Documento raiz da empresa
      // - Qualquer um pode ler (necessário para o useEmpresa buscar pelo slug)
      // - Apenas o dono ou superadmin pode criar/atualizar
      // - Apenas o superadmin pode excluir
      allow read:   if true;
      allow create: if estaAutenticado() && request.auth.uid == empresaId;
      allow update: if eDonoEmpresa(empresaId) || eSuperAdmin();
      allow delete: if eSuperAdmin();

      // ── /empresas/{empresaId}/config/{docId} ────────────
      // Configurações de personalização da empresa.
      // - Qualquer um pode ler (FormPage usa para exibir nome, telefone, cor)
      // - Apenas o dono ou superadmin pode escrever
      match /config/{docId} {
        allow read:   if true;
        allow create: if estaAutenticado() && request.auth.uid == empresaId;
        allow update: if eDonoEmpresa(empresaId) || eSuperAdmin();
        allow delete: if eSuperAdmin();
      }

      // ── /empresas/{empresaId}/tecnicos/{tecnicoId} ──────
      // Gerenciamento de técnicos da equipe.
      // Apenas o dono da empresa ou superadmin pode ler e escrever.
      match /tecnicos/{tecnicoId} {
        allow read:   if eDonoEmpresa(empresaId) || eSuperAdmin();
        allow create: if eDonoEmpresa(empresaId) || eSuperAdmin();
        allow update: if eDonoEmpresa(empresaId) || eSuperAdmin();
        allow delete: if eDonoEmpresa(empresaId) || eSuperAdmin();
      }

      // ── /empresas/{empresaId}/checklist/{osId} ──────────
      match /checklist/{osId} {

        // Leitura: dono, superadmin, ou público para página de avaliação.
        // O osId é um ID aleatório longo, só compartilhado com o segurado
        // via WhatsApp, portanto o risco de acesso indevido é baixo.
        allow read: if eDonoEmpresa(empresaId) || eSuperAdmin() || true;

        // Criação: qualquer um pode criar (formulário público do técnico)
        // Garante que o campo "status" inicial seja "pendente" ou "aguardando_tecnico"
        // e que não venha com campos financeiros preenchidos
        allow create: if
          !('mo_seguradora'      in request.resource.data) &&
          !('valor_prestador'    in request.resource.data) &&
          !('valor_deslocamento' in request.resource.data) &&
          (
            !('status' in request.resource.data) ||
            request.resource.data.status in ['pendente', 'aguardando_tecnico']
          );

        // Atualização pelo admin/superadmin: irrestrita dentro da empresa
        // Atualização pelo técnico (sem auth): apenas campos do formulário
        // Atualização pelo segurado (sem auth): apenas campos de avaliação,
        //   somente uma vez (bloqueia se já existir avaliacao_nota)
        allow update: if
          eDonoEmpresa(empresaId) || eSuperAdmin()
          ||
          // Técnico sem auth — campos do formulário, sem financeiro
          (
            !('mo_seguradora'      in request.resource.data) &&
            !('valor_prestador'    in request.resource.data) &&
            !('valor_deslocamento' in request.resource.data) &&
            request.resource.data.status in ['pendente', 'aguardando_tecnico']
          )
          ||
          // Segurado sem auth — apenas avaliação (1-5), apenas uma vez
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['avaliacao_nota', 'avaliacao_comentario', 'avaliacao_em']) &&
            request.resource.data.avaliacao_nota is int &&
            request.resource.data.avaliacao_nota >= 1 &&
            request.resource.data.avaliacao_nota <= 5 &&
            !('avaliacao_nota' in resource.data)
          );

        // Exclusão: dono da empresa ou superadmin
        allow delete: if eDonoEmpresa(empresaId) || eSuperAdmin();
      }

      // ── /empresas/{empresaId}/orcamentos/{orcamentoId} ───
      // Orçamentos gerados pelo admin, preenchidos pelo técnico
      // e aprovados/reprovados pelo cliente via link público.
      match /orcamentos/{orcamentoId} {

        // Leitura pública: necessário para as páginas públicas do
        // técnico (/orcamento/:slug/:id) e do cliente (/aprovar/:slug/:id)
        // acessarem o documento sem autenticação.
        allow read: if true;

        // Criação: apenas o dono da empresa ou superadmin
        allow create: if eDonoEmpresa(empresaId) || eSuperAdmin();

        // Atualização sem restrição de auth: permite que o técnico
        // (preenche diagnóstico + itens) e o cliente (assina + aprova)
        // atualizem via link público sem precisar estar logado.
        // O admin também pode atualizar (revisão de valores).
        allow update: if true;

        // Exclusão: apenas o dono da empresa ou superadmin
        allow delete: if eDonoEmpresa(empresaId) || eSuperAdmin();
      }
    }
  }
}
