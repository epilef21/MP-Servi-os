// ============================================================
// REGRAS DE SEGURANÇA DO FIRESTORE — AssistHub Multi-tenant
// Versão: v4 (helpers em inglês, isTecnicoOfEmpresa, custom claims)
//
// Estrutura de coleções:
//   config/superadmin              → e-mail do superadmin
//   usuarios/{uid}                 → vínculo uid → empresaId
//   empresas/{empresaId}           → dados raiz da empresa
//   empresas/{empresaId}/checklist/{id}   → OS
//   empresas/{empresaId}/tecnicos/{id}    → técnicos
//   empresas/{empresaId}/orcamentos/{id}  → orçamentos
//   empresas/{empresaId}/config/{id}      → personalização
//   rateLimits/{key}               → controle de rate limiting
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções auxiliares ─────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica superadmin via custom claim (emitido pela CF verifySuperAdmin)
    // O claim expira em 1h — verificado pelo campo superadmin_until
    function isSuperAdmin() {
      return isAuthenticated() &&
        request.auth.token.role == 'superadmin' &&
        request.auth.token.superadmin_until > request.time.toMillis() / 1000;
    }

    // Verifica se o uid autenticado pertence à empresa:
    // 1. uid == empresaId (dono direto)
    // 2. usuarios/{uid}.empresaId == empresaId (vínculo por documento)
    function isUserOfEmpresa(empresaId) {
      return isAuthenticated() && (
        request.auth.uid == empresaId ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.empresaId == empresaId
      );
    }

    // Verifica se o uid autenticado é técnico da empresa.
    // Técnicos têm documento em usuarios/{uid} com tipoUsuario='tecnico'.
    function isTecnicoOfEmpresa(empresaId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipoUsuario == 'tecnico' &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.empresaId == empresaId;
    }

    // ── /rateLimits — controle de rate por Cloud Function ─
    // Apenas as Cloud Functions (via Admin SDK) escrevem aqui;
    // clientes não têm acesso.
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // ── /config — configuração global do superadmin ────────
    // Apenas o superadmin acessa. O documento /config/superadmin
    // deve ser criado manualmente no console Firebase:
    //   { email: "tvf23407@gmail.com" }
    match /config/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ── /usuarios/{uid} ────────────────────────────────────
    // Criado no cadastro para vincular uid → empresaId.
    match /usuarios/{uid} {
      allow read:   if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /empresas/{empresaId} ──────────────────────────────
    match /empresas/{empresaId} {

      // Documento raiz da empresa
      // - Leitura pública: necessário para o useEmpresa buscar pelo slug
      // - Criação: apenas o próprio uid (uid == empresaId por convenção)
      // - Update: dono ou superadmin
      // - Delete: apenas superadmin
      allow read:   if true;
      allow create: if isAuthenticated() && request.auth.uid == empresaId;
      allow update: if isUserOfEmpresa(empresaId) || isSuperAdmin();
      allow delete: if isSuperAdmin();

      // ── /empresas/{empresaId}/config/{docId} ────────────
      // Personalização da empresa (nome, cor, telefone...).
      // Leitura pública: FormPage exibe dados sem autenticação.
      match /config/{docId} {
        allow read:   if true;
        allow create: if isAuthenticated() && request.auth.uid == empresaId;
        allow update: if isUserOfEmpresa(empresaId) || isSuperAdmin();
        allow delete: if isSuperAdmin();
      }

      // ── /empresas/{empresaId}/tecnicos/{tecnicoId} ──────
      // Gerenciamento de técnicos da equipe.
      match /tecnicos/{tecnicoId} {
        allow read:   if isUserOfEmpresa(empresaId) || isSuperAdmin() || isTecnicoOfEmpresa(empresaId);
        allow create: if isUserOfEmpresa(empresaId) || isSuperAdmin();
        allow update: if isUserOfEmpresa(empresaId) || isSuperAdmin();
        allow delete: if isUserOfEmpresa(empresaId) || isSuperAdmin();
      }

      // ── /empresas/{empresaId}/checklist/{osId} ──────────
      match /checklist/{osId} {

        // Leitura pública: página de avaliação usa o osId (ID aleatório longo
        // compartilhado apenas via WhatsApp) — risco de acesso indevido baixo.
        allow read: if true;

        // Criação pública: formulário do técnico não autenticado.
        // Proíbe campos financeiros e restringe status inicial.
        allow create: if
          !('mo_seguradora'      in request.resource.data) &&
          !('valor_prestador'    in request.resource.data) &&
          !('valor_deslocamento' in request.resource.data) &&
          !('maoDeObraSeguradora' in request.resource.data) &&
          !('valorPagoTecnico'   in request.resource.data) &&
          !('kmDeslocamento'     in request.resource.data) &&
          !('lucroReal'          in request.resource.data) &&
          (
            !('status' in request.resource.data) ||
            request.resource.data.status in ['pendente', 'aguardando_tecnico', 'ficou_visita', 'cliente_ausente']
          );

        // Atualização:
        // - Admin/superadmin: irrestrita dentro da empresa
        // - Técnico autenticado da empresa: campos do formulário, sem financeiro
        // - Técnico sem auth: campos do formulário, sem financeiro
        // - Segurado sem auth: apenas avaliação, apenas uma vez
        allow update: if
          isUserOfEmpresa(empresaId) || isSuperAdmin()
          ||
          isTecnicoOfEmpresa(empresaId)
          ||
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'mo_seguradora', 'valor_prestador', 'valor_deslocamento',
              'maoDeObraSeguradora', 'valorPagoTecnico', 'kmDeslocamento', 'lucroReal'
            ]) &&
            request.resource.data.status in ['pendente', 'aguardando_tecnico', 'ficou_visita', 'cliente_ausente']
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['avaliacao_nota', 'avaliacao_comentario', 'avaliacao_em']) &&
            request.resource.data.avaliacao_nota is int &&
            request.resource.data.avaliacao_nota >= 1 &&
            request.resource.data.avaliacao_nota <= 5 &&
            !('avaliacao_nota' in resource.data)
          );

        allow delete: if isUserOfEmpresa(empresaId) || isSuperAdmin();
      }

      // ── /empresas/{empresaId}/orcamentos/{orcamentoId} ───
      // Orçamentos gerados pelo admin, preenchidos pelo técnico,
      // aprovados/reprovados pelo cliente via link público.
      match /orcamentos/{orcamentoId} {

        // Leitura pública: páginas /orcamento/:slug/:id e /aprovar/:slug/:id
        allow read: if true;

        allow create: if isUserOfEmpresa(empresaId) || isSuperAdmin();

        allow update: if
          isUserOfEmpresa(empresaId) || isSuperAdmin()
          ||
          (
            resource.data.status == 'aguardando_tecnico' &&
            request.resource.data.status == 'em_revisao' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'diagnostico', 'itens', 'total_geral', 'total_cliente',
              'total_seguradora', 'forma_pagamento', 'prazo_execucao',
              'observacoes', 'fotos', 'num_serie', 'marca', 'modelo',
              'voltagem', 'preenchido_em'
            ])
          )
          ||
          (
            resource.data.status == 'enviado_cliente' &&
            request.resource.data.status == 'aprovado' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'aprovado_por', 'assinatura_cliente', 'aprovado_em'
            ])
          )
          ||
          (
            resource.data.status == 'enviado_cliente' &&
            request.resource.data.status == 'reprovado' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'motivo_reprovacao'
            ])
          );

        allow delete: if isUserOfEmpresa(empresaId) || isSuperAdmin();
      }
    }
  }
}
