# ============================================================
# Cloud Functions — Variáveis de Ambiente
# Copie para functions/.env e preencha antes de fazer deploy.
# NUNCA suba functions/.env para o git.
# ============================================================

# URL do frontend (usada para gerar link_publico nas OS)
APP_URL=https://mp-servi-os.vercel.app

# E-mail do superadmin (deve corresponder ao Firebase Auth)
SUPERADMIN_EMAIL=tvf23407@gmail.com

# Hash bcrypt da senha do painel superadmin.
# Para gerar: node -e "const b=require('bcryptjs'); console.log(b.hashSync('SUA_SENHA_FORTE',12))"
SUPERADMIN_PASSWORD_HASH=

# ID da extensão Chrome/Edge (visível em edge://extensions após carregar a extensão).
# Formato: 32 letras minúsculas, ex: abcdefghijklmnopqrstuvwxyzabcdef
# Restringe o CORS da criarOSFromExtension apenas à extensão e ao frontend.
EXTENSION_ID=
